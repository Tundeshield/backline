# --- Firebase (client) — leave blank to run in Demo mode (data stays in the browser)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Server-side (Netlify environment variables, NOT prefixed with VITE_)
# E-invoicing: NRS MBS via an accredited Access Point Provider.
# EINVOICE_MODE=sandbox generates test IRNs locally; set to "live" once you have APP credentials.
EINVOICE_MODE=sandbox
APP_BASE_URL=
APP_API_KEY=
APP_API_SECRET=

# AI agent (WhatsApp / email replies). Without a key the agent uses rule-based replies.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# WhatsApp Cloud API (Meta)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Backline <invoices@yourdomain.com>
